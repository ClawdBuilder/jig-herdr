{
    "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double"
        }
    },
    "overrides": [
        {
            "includes": ["themes/*.json"],
            "formatter": {
                "indentWidth": 2
            }
        },
        {
            "includes": ["mods/**"],
            "linter": {
                "rules": {
                    "correctness": {
                        "noUndeclaredVariables": "error"
                    },
                    "style": {
                        "noRestrictedGlobals": {
                            "level": "error",
                            "options": {
                                "deniedGlobals": {
                                    "setTimeout": "Use cx.timer.after or cx.timer.every",
                                    "setInterval": "Use cx.timer.every",
                                    "clearTimeout": "Use the cx.timer task",
                                    "clearInterval": "Use the cx.timer task",
                                    "setImmediate": "Use cx.timer.after"
                                }
                            }
                        }
                    }
                }
            },
            "javascript": {
                "globals": ["localStorage"]
            }
        }
    ],
    "files": {
        "includes": ["**", "!**/gpui-kit.d.ts", "!**/jsconfig.json"]
    }
}

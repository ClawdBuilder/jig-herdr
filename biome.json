{
    "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double"
        }
    },
    "overrides": [
        {
            "includes": ["themes/*.json"],
            "formatter": {
                "indentWidth": 2
            }
        },
        {
            "includes": ["mods/**"],
            "linter": {
                "rules": {
                    "correctness": {
                        "noUndeclaredVariables": "error"
                    }
                }
            },
            "javascript": {
                "globals": ["localStorage"]
            }
        }
    ]
}

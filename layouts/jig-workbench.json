{
    "id": "root",
    "type": "row",
    "titlebar": "none",
    "traffic_lights": [12, 16],
    "background": "canvas",
    "terminal_padding": [14, 12],
    "divider": {
        "width": 1,
        "color": "border"
    },
    "preview": "layouts/jig-workbench.svg",
    "children": [
        {
            "id": "sidebar",
            "type": "column",
            "size": {
                "px": 300
            },
            "min": 44,
            "max": 520,
            "background": "chrome",
            "resizable": false,
            "children": [
                {
                    "id": "brand",
                    "type": "block",
                    "size": {
                        "px": 46
                    },
                    "window_drag": true,
                    "content": {
                        "mod": "workspace-chrome"
                    }
                },
                {
                    "id": "sidebar-lists",
                    "type": "column",
                    "children": [
                        {
                            "id": "spaces",
                            "type": "block",
                            "size": {
                                "weight": 1
                            },
                            "min": 90,
                            "content": {
                                "mod": "spaces"
                            }
                        },
                        {
                            "id": "agents",
                            "type": "block",
                            "size": {
                                "weight": 1
                            },
                            "min": 90,
                            "content": {
                                "mod": "agents"
                            }
                        }
                    ]
                },
                {
                    "id": "jig-keep-awake",
                    "type": "block",
                    "size": {
                        "px": 0
                    },
                    "content": {
                        "mod": "jig-keep-awake"
                    }
                },
                {
                    "id": "sidebar-footer",
                    "type": "block",
                    "size": {
                        "px": 69
                    },
                    "content": {
                        "mod": "workspace-chrome",
                        "props": {
                            "footer": true
                        }
                    }
                }
            ]
        },
        {
            "id": "work",
            "type": "column",
            "resizable": false,
            "children": [
                {
                    "id": "tabs",
                    "type": "block",
                    "size": {
                        "px": 30
                    },
                    "window_drag": true,
                    "content": {
                        "mod": "tabs"
                    }
                },
                {
                    "id": "work-body",
                    "type": "row",
                    "padding": 8,
                    "gap": 8,
                    "children": [
                        {
                            "id": "main",
                            "type": "block",
                            "content": {
                                "tab": "active",
                                "pane": {
                                    "gap": 8,
                                    "radius": 10,
                                    "background": "background",
                                    "lone": true,
                                    "border": {
                                        "width": 1,
                                        "color": "border"
                                    },
                                    "focus": {
                                        "width": 1,
                                        "color": "accent"
                                    },
                                    "header": {
                                        "content": {
                                            "mod": "pane"
                                        },
                                        "height": 30,
                                        "position": "top",
                                        "reveal": "always"
                                    }
                                }
                            }
                        },
                        {
                            "id": "panel",
                            "type": "row",
                            "size": {
                                "px": 420
                            },
                            "min": 300,
                            "max": 900,
                            "children": [
                                {
                                    "id": "panel-body",
                                    "type": "stack",
                                    "active": "changes",
                                    "children": [
                                        {
                                            "id": "changes",
                                            "type": "block",
                                            "title": "Git",
                                            "content": {
                                                "mod": "jig-git",
                                                "props": {
                                                    "activity": {
                                                        "icon": "mods/workspace-chrome/git-compare.svg"
                                                    }
                                                }
                                            }
                                        },
                                        {
                                            "id": "history",
                                            "type": "block",
                                            "title": "History",
                                            "content": {
                                                "mod": "jig-history",
                                                "props": {
                                                    "activity": {
                                                        "icon": "mods/workspace-chrome/clock.svg"
                                                    }
                                                }
                                            }
                                        },
                                        {
                                            "id": "pr",
                                            "type": "block",
                                            "title": "PR & CI",
                                            "content": {
                                                "mod": "jig-prs",
                                                "props": {
                                                    "activity": {
                                                        "icon": "mods/jig-activity/icons/pr.svg"
                                                    }
                                                }
                                            }
                                        },
                                        {
                                            "id": "worktrees",
                                            "type": "block",
                                            "title": "Worktrees",
                                            "content": {
                                                "mod": "jig-worktrees",
                                                "props": {
                                                    "activity": {
                                                        "icon": "mods/jig-activity/icons/worktree.svg"
                                                    }
                                                }
                                            }
                                        },
                                        {
                                            "id": "review",
                                            "type": "block",
                                            "title": "Review",
                                            "content": {
                                                "mod": "jig-review",
                                                "props": {
                                                    "activity": {
                                                        "icon": "mods/workspace-chrome/file-text.svg"
                                                    }
                                                }
                                            }
                                        },
                                        {
                                            "id": "files",
                                            "type": "block",
                                            "title": "Files",
                                            "content": {
                                                "mod": "jig-files",
                                                "props": {
                                                    "activity": {
                                                        "icon": "mods/workspace-chrome/files.svg"
                                                    }
                                                }
                                            }
                                        }
                                    ]
                                },
                                {
                                    "id": "activity",
                                    "type": "block",
                                    "size": {
                                        "px": 40
                                    },
                                    "resizable": false,
                                    "content": {
                                        "mod": "jig-activity",
                                        "props": {
                                            "stack": "panel-body"
                                        }
                                    }
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ]
}
